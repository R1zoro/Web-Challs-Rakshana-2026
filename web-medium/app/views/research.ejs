<%- include('partials/header') %>

<!-- Research Banner -->
<div class="py-4 bg-white border-bottom border-subtle">
    <div class="container">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-light border border-subtle rounded-pill text-primary small fw-bold mb-2">
            <span class="badge bg-primary">ACADEMIC & STRATEGIC DISCLOSURES</span>
            <span>DIVISION OF ADVANCED NUCLEAR RESEARCH & APPLIED PHYSICS</span>
        </div>
        <h2 class="fw-bold text-dark mb-1">
            Research Publications & Scientific Accomplishments
        </h2>
        <p class="text-secondary mb-0 small">
            Peer-reviewed scientific literature in heavy water moderating physics, thorium fuel cycle breeding kinetics, medical radioisotope extraction, and passive decay heat dissipation.
        </p>
    </div>
</div>

<div class="container my-5">
    <!-- Search / Filter bar for research papers -->
    <div class="nrf-card p-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-lg-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="researchSearchInput" class="form-control border-start-0 ps-0" placeholder="Filter research by keyword (e.g. thorium, lutetium, kalman, cold neutron)...">
                </div>
            </div>
            <div class="col-lg-6 text-lg-end">
                <span class="small text-muted fw-semibold">
                    Total Publications: <span class="badge bg-light text-dark border font-monospace"><%= researchPapers.length %> Papers</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Publications List -->
    <div class="row g-4" id="researchPapersContainer">
        <% researchPapers.forEach(function(paper) { %>
        <div class="col-12 research-paper-item" data-keywords="<%= (paper.title + ' ' + paper.authors + ' ' + paper.keywords + ' ' + paper.abstract).toLowerCase() %>">
            <div class="nrf-card p-4 doc-card">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start mb-2 gap-2">
                    <div>
                        <span class="badge bg-primary font-monospace small me-2"><%= paper.id %></span>
                        <span class="badge bg-light text-secondary border small"><%= paper.division %></span>
                    </div>
                    <span class="small text-muted font-monospace"><i class="bi bi-calendar3 me-1"></i><%= paper.date %></span>
                </div>

                <h5 class="fw-bold text-dark mb-2 mt-2">
                    <%= paper.title %>
                </h5>

                <div class="small text-primary fw-semibold mb-2">
                    <i class="bi bi-people me-1 text-secondary"></i> <%= paper.authors %>
                </div>

                <div class="small text-muted mb-3 fst-italic">
                    <i class="bi bi-journal-bookmark me-1"></i> Published in: <strong><%= paper.journal %></strong>
                </div>

                <div class="p-3 bg-light rounded border text-secondary small mb-3" style="line-height: 1.6;">
                    <%= paper.abstract %>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="small text-muted fw-bold"><i class="bi bi-tags me-1"></i>Keywords:</span>
                    <% paper.keywords.split(',').forEach(function(kw) { %>
                        <span class="badge bg-white text-dark border"><%= kw.trim() %></span>
                    <% }); %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const searchInput = document.getElementById("researchSearchInput");
    const paperItems = document.querySelectorAll(".research-paper-item");

    if (searchInput) {
        searchInput.addEventListener("input", function () {
            const q = this.value.trim().toLowerCase();
            paperItems.forEach(item => {
                const keywords = item.getAttribute("data-keywords");
                if (!q || keywords.includes(q)) {
                    item.style.display = "";
                } else {
                    item.style.display = "none";
                }
            });
        });
    }
});
</script>

<%- include('partials/footer') %>
