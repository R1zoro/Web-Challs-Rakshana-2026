<%- include('partials/header') %>

<div class="container my-5">

    <!-- Session Header (No tokens for public viewers!) -->
    <div class="nrf-card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge badge-clean-safe mb-1">CLEARANCE LEVEL 1: PUBLIC OBSERVER</span>
                <h3 class="fw-bold text-dark mb-1">Terminal Session: <%= user.sub %></h3>
                <p class="text-secondary small mb-0">Authorized civil monitoring session for open radiological data streams.</p>
            </div>
            <div class="text-md-end">
                <span class="metric-label d-block">Access Privilege</span>
                <span class="badge bg-light text-dark border font-monospace px-3 py-2 fs-6">
                    <i class="bi bi-eye-fill text-primary me-1"></i> Read-Only Public Observer
                </span>
            </div>
        </div>
    </div>

    <!-- Restricted Notice Box -->
    <div class="nrf-card p-4 mb-4" style="border-left: 5px solid var(--status-warn);">
        <div class="d-flex align-items-start gap-3">
            <i class="bi bi-shield-exclamation text-warning fs-2 mt-1"></i>
            <div>
                <h5 class="fw-bold text-dark mb-1">Restricted Core Actuation & SCRAM Gateway</h5>
                <p class="small text-secondary mb-0">
                    Primary Reactor SCRAM actuation and diagnostic override relays are strictly restricted to certified <strong>Level-3+ Commander</strong> personnel. 
                    Public Observer sessions hold zero operational control privileges.
                </p>
            </div>
        </div>
    </div>

    <!-- Active Telemetry Feeds -->
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="nrf-card h-100">
                <div class="nrf-card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-activity text-primary me-2"></i> Perimeter Radiation Detectors</span>
                    <span class="badge badge-clean-safe font-monospace">ONLINE</span>
                </div>
                <div class="p-0">
                    <table class="table nrf-table">
                        <thead>
                            <tr>
                                <th>Detector</th>
                                <th>Location</th>
                                <th>MicroSieverts</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="font-monospace fw-bold text-primary">GM-01</td>
                                <td>Perimeter North Fence</td>
                                <td><span class="badge badge-clean-safe font-monospace">0.120 µSv/h</span></td>
                            </tr>
                            <tr>
                                <td class="font-monospace fw-bold text-primary">GM-02</td>
                                <td>Cooling Tower Effluent</td>
                                <td><span class="badge badge-clean-safe font-monospace">0.140 µSv/h</span></td>
                            </tr>
                            <tr>
                                <td class="font-monospace fw-bold text-primary">GM-03</td>
                                <td>Reactor Core Outer Shield</td>
                                <td><span class="badge badge-clean-warn font-monospace">0.280 µSv/h</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="nrf-card h-100 d-flex flex-column">
                <div class="nrf-card-header">
                    <i class="bi bi-clouds-fill text-primary me-2"></i> Meteorological Dispersion Station
                </div>
                <div class="p-4 small text-secondary flex-grow-1">
                    <div class="mb-2">
                        <strong class="text-dark">Atmospheric Stability Class:</strong>
                        <span class="text-secondary ms-1">Pasquill-D (Neutral Dispersion)</span>
                    </div>
                    <div class="mb-3">
                        <strong class="text-dark">Primary Anemometer Feed:</strong>
                        <span class="text-secondary ms-1">ENE @ 14.2 km/h</span>
                    </div>
                    <div class="p-3 bg-light rounded border text-muted small">
                        <strong>Telemetry Sync Channel:</strong> <span class="font-monospace text-dark">ws://incident-portal.internal:8002/telemetry/stream</span><br>
                        AERB Statutory Public Mandate Section 14 Verified.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Statutory Disclosures Available for Observer -->
    <div class="nrf-card">
        <div class="nrf-card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold"><i class="bi bi-file-earmark-text text-primary me-2"></i> Recent Public Regulatory Disclosures & Environmental Audits</span>
            <a href="/#reports" class="btn btn-sm btn-outline-primary">Browse Full Public Archive &rarr;</a>
        </div>
        <div class="p-0">
            <table class="table nrf-table align-middle">
                <thead>
                    <tr>
                        <th style="width: 150px;">Circular Code</th>
                        <th>Report Title</th>
                        <th>Category</th>
                        <th>Publication Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (typeof recentReports !== 'undefined' && recentReports.length > 0) { %>
                        <% recentReports.forEach(function(rep) { %>
                        <tr>
                            <td class="font-monospace fw-bold text-primary"><%= rep.id %></td>
                            <td>
                                <strong class="text-dark d-block"><%= rep.title %></strong>
                                <span class="small text-muted"><%= rep.summary.substring(0, 110) %>...</span>
                            </td>
                            <td><span class="badge bg-light text-dark border"><%= rep.category %></span></td>
                            <td class="small text-muted font-monospace"><%= rep.date %></td>
                        </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

</div>

<%- include('partials/footer') %>
