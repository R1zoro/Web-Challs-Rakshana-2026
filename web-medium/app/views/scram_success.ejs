<%- include('partials/header') %>

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="nrf-card p-5 text-center" style="border-top: 6px solid var(--status-safe);">
                <div class="mb-3">
                    <i class="bi bi-shield-check text-success display-2"></i>
                </div>
                <span class="badge badge-clean-safe mb-2 text-uppercase fs-6">
                    EMERGENCY CORE SCRAM COMPLETE
                </span>
                <h2 class="fw-bold text-dark mb-2">Reactor Core Excursion Terminated</h2>
                <p class="text-secondary small mb-4">
                    Boron-10 secondary shutoff assemblies fully deployed into reactor lattice. Prompt neutron cascade interrupted. Primary coolant temperature stabilizing.
                </p>

                <!-- Investigation Flag Card -->
                <div class="p-4 bg-light rounded border text-start mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="small text-muted text-uppercase fw-bold"><i class="bi bi-flag-fill text-success me-1"></i> Investigation Discovery Flag</span>
                        <button type="button" class="btn btn-sm btn-outline-success py-0 px-2" id="copyFlagBtn" onclick="copyFlagText()">
                            <i class="bi bi-clipboard me-1"></i>Copy
                        </button>
                    </div>
                    <div class="p-3 bg-white border border-2 border-success-subtle rounded text-dark font-monospace fw-bold user-select-all mb-3 shadow-sm" id="flagDisplay" style="word-break: break-all; overflow-wrap: anywhere; font-size: 1.05rem; line-height: 1.5;">
                        <%= flag %>
                    </div>

                    <hr class="my-3">

                    <span class="small text-muted text-uppercase fw-bold d-block mb-1">Operational Technology (SCADA) Gateway Discovered:</span>
                    <p class="small text-secondary mb-2">
                        During the emergency scram cycle, an unisolated telemetry bridge exposed the internal SCADA network relay:
                    </p>
                    <div class="p-2 bg-white rounded border text-primary font-monospace small fw-bold" style="word-break: break-all; overflow-wrap: anywhere;">
                        <%= scada_internal_gateway %>
                    </div>
                </div>
                <script>
                function copyFlagText() {
                    const text = document.getElementById("flagDisplay").innerText.trim();
                    navigator.clipboard.writeText(text).then(() => {
                        const btn = document.getElementById("copyFlagBtn");
                        btn.innerHTML = "<i class='bi bi-check2 me-1'></i>Copied!";
                        setTimeout(() => {
                            btn.innerHTML = "<i class='bi bi-clipboard me-1'></i>Copy";
                        }, 2000);
                    });
                }
                </script>

                <a href="/dashboard" class="btn btn-institutional-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i>Return to Commander Terminal
                </a>
            </div>

        </div>
    </div>
</div>

<%- include('partials/footer') %>
