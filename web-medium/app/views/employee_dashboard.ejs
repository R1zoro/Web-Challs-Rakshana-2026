<%- include('partials/header') %>

<div class="container my-5">

    <!-- Emergency Commander Alert Banner -->
    <div class="commander-alert-banner mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge badge-clean-alert mb-2 px-3 py-1 text-uppercase">
                    <i class="bi bi-exclamation-octagon-fill me-1"></i> Core Excursion Alert &mdash; Level 4 Active
                </span>
                <h3 class="fw-bold text-dark mb-1">Reactor Core Thermal Excursion in Progress</h3>
                <p class="small text-secondary mb-0">
                    Primary coolant loop pressure is critical. Commander authorization tokens required to actuate rapid scram neutron absorber insertion.
                </p>
            </div>
            <a href="/reactor/scram/override" class="btn btn-danger px-4 py-2 fw-bold text-nowrap shadow-sm">
                <i class="bi bi-shield-slash-fill me-1"></i>Initiate Emergency SCRAM
            </a>
        </div>
    </div>

    <!-- Core Telemetry Matrix (All High-Contrast & 100% Readable) -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="metric-tile" style="border-left: 4px solid var(--status-alert);">
                <span class="metric-label d-block text-danger">Fuel Cladding Temp</span>
                <div class="metric-value text-danger" id="gaugeCoreTemp"><%= coreTemp %> °C</div>
                <div class="metric-sub text-danger font-monospace">Thermal safety threshold (1,800 °C) exceeded</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-tile" style="border-left: 4px solid var(--status-warn);">
                <span class="metric-label d-block text-dark">Primary Coolant Loop</span>
                <div class="metric-value text-dark"><%= coolantPressure %> bar</div>
                <div class="metric-sub text-muted font-monospace">Auxiliary relief valves: ACTIVE DUMP</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-tile" style="border-left: 4px solid var(--brand-blue);">
                <span class="metric-label d-block text-primary">Safety Authorization Quota</span>
                <div class="metric-value text-primary font-monospace"><%= tokens %> Tokens</div>
                <div class="metric-sub text-secondary">SCRAM interlock requirement: <strong class="text-dark">1,000 Tokens</strong></div>
            </div>
        </div>
    </div>

    <!-- Operator Terminal Settings & Diagnostics -->
    <div class="nrf-card mb-4">
        <div class="nrf-card-header d-flex justify-content-between align-items-center">
            <span class="fw-bold text-dark">
                <i class="bi bi-sliders text-primary me-2"></i> Operator Telemetry Thresholds & Terminal Preferences
            </span>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-light text-secondary border font-monospace"><i class="bi bi-cpu me-1"></i>Station UI v4.8</span>
            </div>
        </div>
        <div class="p-4">
            <p class="small text-secondary mb-4">
                Customize operational terminal telemetry refresh rates, audible klaxon triggers, and display density.
            </p>

            <form id="commanderPrefForm">
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-dark mb-1">Terminal Visual Theme</label>
                        <select id="prefTheme" class="form-select">
                            <option value="institutional-light" selected>Institutional Light (Standard)</option>
                            <option value="high-contrast-alert">High Contrast Red Alert</option>
                            <option value="monochrome-crt">Amber Monochromatic CRT</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-dark mb-1">Telemetry Poll Rate (ms)</label>
                        <input type="number" id="prefRefreshRate" class="form-control" value="3000">
                    </div>
                    <div class="col-md-4 d-flex align-items-center pt-3">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" id="prefAlertSound" checked>
                            <label class="form-check-label small fw-bold text-dark" for="prefAlertSound">Audible Klaxon Alerts</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end align-items-center pt-2">
                    <button type="submit" class="btn btn-institutional-primary px-4 fw-semibold shadow-sm">
                        <i class="bi bi-floppy-fill me-1"></i>Save Terminal Preferences
                    </button>
                </div>
            </form>

            <div id="prefFeedback" class="d-none"></div>
        </div>
        <div class="p-3 bg-light border-top small text-muted">
            <i class="bi bi-shield-check me-1"></i> Session settings synchronized via MAIT Core Telemetry Engine.
        </div>
    </div>

</div>

<%- include('partials/footer') %>
