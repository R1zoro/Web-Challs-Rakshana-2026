<%- include('partials/header') %>

<!-- Events Banner -->
<div class="py-4 bg-white border-bottom border-subtle">
    <div class="container">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-light border border-subtle rounded-pill text-primary small fw-bold mb-2">
            <span class="badge bg-primary">CIVIL DEFENSE & DRILLS</span>
            <span>PUBLIC SAFETY CALENDAR & REGULATORY AUDIT ARCHIVE</span>
        </div>
        <h2 class="fw-bold text-dark mb-1">
            Civil Defense Drills, Tabletop Exercises & Technical Events
        </h2>
        <p class="text-secondary mb-0 small">
            Statutory civil defense siren tests in Sector 22 Rohini, IAEA safeguards verification visits, emergency hospital triage drills, and national reactor symposiums.
        </p>
    </div>
</div>

<div class="container my-5">
    <!-- Filter bar -->
    <div class="nrf-card p-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-lg-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="eventSearchInput" class="form-control border-start-0 ps-0" placeholder="Filter events by keyword (e.g. siren, drill, muster, iaea)...">
                </div>
            </div>
            <div class="col-lg-7 d-flex flex-wrap gap-2 align-items-center justify-content-lg-end">
                <span class="small text-muted fw-bold me-1">Category:</span>
                <button type="button" class="btn-filter-pill active" data-type="All">All (<%= events.length %>)</button>
                <button type="button" class="btn-filter-pill" data-type="Civil Defense Drill">Civil Defense</button>
                <button type="button" class="btn-filter-pill" data-type="Regulatory Audit">AERB Audits</button>
                <button type="button" class="btn-filter-pill" data-type="Operational Test">Operational Tests</button>
                <button type="button" class="btn-filter-pill" data-type="Academic Symposium">Symposiums</button>
            </div>
        </div>
    </div>

    <!-- Events Cards Grid -->
    <div class="row g-4" id="eventsGrid">
        <% events.forEach(function(evt) { %>
        <div class="col-lg-6 event-item-card" data-type="<%= evt.type %>" data-keywords="<%= (evt.title + ' ' + evt.type + ' ' + evt.description + ' ' + evt.location + ' ' + evt.mandate).toLowerCase() %>">
            <div class="nrf-card p-4 h-100 doc-card d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="badge <%= evt.status === 'Upcoming' ? 'badge-clean-warn' : 'badge-clean-safe' %>">
                        <i class="bi <%= evt.status === 'Upcoming' ? 'bi-clock' : 'bi-check2-circle' %> me-1"></i><%= evt.status %>
                    </span>
                    <span class="badge bg-light text-secondary border font-monospace"><%= evt.id %></span>
                </div>

                <h5 class="fw-bold text-dark mb-2"><%= evt.title %></h5>

                <div class="row g-2 small mb-3 text-muted">
                    <div class="col-sm-6">
                        <i class="bi bi-calendar3 me-1 text-primary"></i> <span class="font-monospace text-dark"><%= evt.date %></span>
                    </div>
                    <div class="col-sm-6">
                        <i class="bi bi-alarm me-1 text-primary"></i> <%= evt.time %>
                    </div>
                    <div class="col-12">
                        <i class="bi bi-geo-alt me-1 text-danger"></i> <%= evt.location %>
                    </div>
                </div>

                <p class="small text-secondary mb-3 flex-grow-1" style="line-height: 1.55;">
                    <%= evt.description %>
                </p>

                <div class="p-2 bg-light rounded border small text-muted mb-2">
                    <strong class="text-dark d-block mb-1"><i class="bi bi-people me-1"></i>Participants:</strong>
                    <span><%= evt.participants %></span>
                </div>

                <div class="small text-muted font-monospace border-top pt-2 mt-auto">
                    <i class="bi bi-file-earmark-check text-success me-1"></i> Mandate: <%= evt.mandate %>
                </div>
            </div>
        </div>
        <% }); %>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    let currentType = "All";
    const searchInput = document.getElementById("eventSearchInput");
    const eventCards = document.querySelectorAll(".event-item-card");
    const filterPills = document.querySelectorAll(".btn-filter-pill");

    function applyFilters() {
        const q = searchInput ? searchInput.value.trim().toLowerCase() : "";
        eventCards.forEach(card => {
            const cardType = card.getAttribute("data-type");
            const keywords = card.getAttribute("data-keywords");
            const matchesType = (currentType === "All" || cardType === currentType);
            const matchesQuery = (!q || keywords.includes(q));

            if (matchesType && matchesQuery) {
                card.style.display = "";
            } else {
                card.style.display = "none";
            }
        });
    }

    if (searchInput) {
        searchInput.addEventListener("input", applyFilters);
    }

    filterPills.forEach(pill => {
        pill.addEventListener("click", function () {
            filterPills.forEach(p => p.classList.remove("active"));
            this.classList.add("active");
            currentType = this.getAttribute("data-type");
            applyFilters();
        });
    });
});
</script>

<%- include('partials/footer') %>
