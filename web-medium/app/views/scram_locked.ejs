<%- include('partials/header') %>

<div class="container my-5 py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">

            <div class="nrf-card p-5" style="border-top: 6px solid var(--status-alert);">
                <div class="mb-3">
                    <i class="bi bi-shield-x text-danger display-2"></i>
                </div>
                <span class="badge badge-clean-alert mb-2 text-uppercase fs-6">
                    SCRAM AUTHORIZATION INTERLOCK DENIED
                </span>
                <h3 class="fw-bold text-dark mb-3">Insufficient Safety Override Tokens</h3>

                <p class="text-secondary small mb-4">
                    Statutory reactor safety interlocks prevent unauthorized emergency rod insertion. 
                    Actuating an emergency core scram requires a minimum safety token balance of 
                    <strong class="text-dark"><%= requiredTokens %> Tokens</strong>.
                </p>

                <div class="p-3 bg-light rounded border mb-4 font-monospace">
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted">Required Authorization Balance:</span>
                        <strong class="text-danger"><%= requiredTokens %> Tokens</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Your Active Authorized Balance:</span>
                        <strong class="text-warning"><%= currentTokens %> Tokens</strong>
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a href="/dashboard" class="btn btn-outline-secondary px-4 fw-semibold">
                        <i class="bi bi-arrow-left me-1"></i>Return to Commander Dashboard
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('partials/footer') %>
