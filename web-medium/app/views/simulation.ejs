<%- include('partials/header') %>

<!-- Simulation Hero Banner -->
<div class="nrf-hero-banner py-4 border-bottom border-subtle">
    <div class="container">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-white rounded-pill shadow-xs mb-2 text-primary small fw-semibold">
            <i class="bi bi-cpu-fill text-warning"></i>
            <span>C&amp;I OPERATIONAL SIMULATION SANDBOX &bull; SIL-3 CERTIFIED DIGITAL TWIN</span>
        </div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-sliders text-primary me-2"></i>Interactive Reactor Facility Digital Twin
        </h2>
        <p class="text-secondary small mb-0">
            AERB operator training simulator modeling primary coolant transport, control rod reactivity suppression, and heavy water flow dynamics. Manipulate facility components to inspect real-time instrumentation telemetry.
        </p>
    </div>
</div>

<div class="container my-5">

    <!-- Subsystem Controls Grid -->
    <div class="row g-4 mb-5">

        <!-- 1. Control Rods Adjustment (rod change) -->
        <div class="col-lg-4">
            <div class="nrf-card h-100 p-4 border-top border-4 border-primary d-flex flex-column shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 bg-primary-subtle text-primary rounded">
                        <i class="bi bi-arrow-down-up fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">1. Control Rod Banks</h5>
                        <span class="small text-muted">Reactivity Suppression</span>
                    </div>
                </div>
                <p class="small text-secondary flex-grow-1">
                    Modulate boron carbide (B4C) control rod penetration depth to control neutron multiplication factor ($k_{\text{eff}}$).
                </p>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Bank Insertion Level</label>
                    <select id="rodSelect" class="form-select form-select-sm">
                        <option value="15">15% Insertion (Full Power Critical)</option>
                        <option value="35">35% Insertion (Load-Follow Trim)</option>
                        <option value="50" selected>50% Insertion (Intermediate Hold)</option>
                        <option value="75">75% Insertion (Deep Power Suppression)</option>
                        <option value="100">100% Insertion (Full SCRAM Ingestion)</option>
                    </select>
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary fw-semibold w-100" onclick="runSimulation('control_rods')">
                    <i class="bi bi-play-fill me-1"></i>Apply Rod Change
                </button>
            </div>
        </div>

        <!-- 2. Heavy Water Moderator Adjustment (heavy water change) -->
        <div class="col-lg-4">
            <div class="nrf-card h-100 p-4 border-top border-4 border-info d-flex flex-column shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 bg-info-subtle text-info rounded">
                        <i class="bi bi-droplet-half fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">2. Heavy Water (D2O)</h5>
                        <span class="small text-muted">Moderator &amp; Coolant Loop</span>
                    </div>
                </div>
                <p class="small text-secondary flex-grow-1">
                    Regulate primary heat transport heavy water circulation loop to maintain moderator temperature and PHT pressure equilibrium.
                </p>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">D2O Circulation Rate</label>
                    <select id="heavyWaterSelect" class="form-select form-select-sm">
                        <option value="380">380 kg/s (Reduced Recirculation Flow)</option>
                        <option value="420" selected>420 kg/s (Rated Nominal Thermal Flow)</option>
                        <option value="460">460 kg/s (Maximum Decay Heat Cooling)</option>
                    </select>
                </div>
                <button type="button" class="btn btn-sm btn-outline-info fw-semibold w-100 text-dark" onclick="runSimulation('heavy_water')">
                    <i class="bi bi-play-fill me-1"></i>Apply Heavy Water Change
                </button>
            </div>
        </div>

        <!-- 3. Fuel Assembly Loading (fuel change) -->
        <div class="col-lg-4">
            <div class="nrf-card h-100 p-4 border-top border-4 border-warning d-flex flex-column shadow-sm">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <div class="p-2 bg-warning-subtle text-warning-emphasis rounded">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold text-dark mb-0">3. Fuel Assembly</h5>
                        <span class="small text-muted">Core Matrix Configuration</span>
                    </div>
                </div>
                <p class="small text-secondary flex-grow-1">
                    Configure nuclear fuel lattice enrichment profile to evaluate delayed neutron precursors and Doppler coefficients.
                </p>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Enrichment Profile</label>
                    <select id="fuelSelect" class="form-select form-select-sm">
                        <option value="LEU_3.2" selected>LEU 3.2% UO2 (Standard Core Lattice)</option>
                        <option value="MOX_4.0">MOX 4.0% Pu-U (Recycled Mixed Oxide)</option>
                        <option value="THORIUM_NAT">Natural Thorium-232 Blanket Matrix</option>
                    </select>
                </div>
                <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-semibold w-100" onclick="runSimulation('fuel_assembly')">
                    <i class="bi bi-play-fill me-1"></i>Apply Fuel Change
                </button>
            </div>
        </div>

    </div>

    <!-- Graphical Reactor Digital Twin Mimic Display -->
    <div class="card border-0 shadow-sm overflow-hidden bg-white mb-4">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success font-monospace" id="simStatusBadge">SYNCHRONIZED</span>
                <span class="fw-bold small font-monospace"><i class="bi bi-display me-1"></i>PRIMARY CALANDRIA &amp; REACTOR CORE MIMIC SCHEMATIC</span>
            </div>
            <div class="small font-monospace text-muted d-flex align-items-center gap-3">
                <span id="syncNotice" class="text-success small fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Telemetry bus live</span>
                <span id="simTimestamp">Loop State: Stable</span>
            </div>
        </div>

        <div class="card-body p-4 bg-light">
            <div class="row g-4 align-items-center">

                <!-- Visual Graphical Reactor Core SVG Schematic -->
                <div class="col-lg-7 text-center">
                    <div class="p-3 bg-dark rounded-3 shadow-inner border border-secondary" style="background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%);">
                        <svg viewBox="0 0 600 380" class="w-100" style="max-height: 380px;" xmlns="http://www.w3.org/2000/svg">
                            <!-- Background Grid -->
                            <defs>
                                <pattern id="scadaGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
                                </pattern>
                                <!-- Coolant Gradient -->
                                <linearGradient id="coolantGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#0284c7" stop-opacity="0.8"/>
                                    <stop offset="100%" stop-color="#38bdf8" stop-opacity="0.9"/>
                                </linearGradient>
                                <!-- Fuel Glow Filter -->
                                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                                    <feGaussianBlur stdDeviation="3" result="blur" />
                                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                                </filter>
                            </defs>
                            <rect width="600" height="380" fill="url(#scadaGrid)" />

                            <!-- Primary Coolant Inflow / Outflow Pipes -->
                            <path id="svgInletPipe" d="M 40 280 L 160 280 L 160 220" fill="none" stroke="#00f5d4" stroke-width="16" stroke-linecap="round" style="transition: stroke 0.6s ease;" />
                            <path d="M 440 160 L 440 100 L 560 100" fill="none" stroke="#ef4444" stroke-width="16" stroke-linecap="round" />
                            <text x="50" y="260" fill="#38bdf8" font-size="11" font-family="monospace" font-weight="bold">D2O INLET [288°C]</text>
                            <text x="450" y="80" fill="#f87171" font-size="11" font-family="monospace" font-weight="bold">HOT LEG OUT [342°C]</text>

                            <!-- Calandria Vessel (Reactor Tank) Outer Hull -->
                            <rect x="160" y="50" width="280" height="280" rx="36" fill="#1e293b" stroke="#64748b" stroke-width="4" />
                            <rect x="180" y="70" width="240" height="240" rx="24" fill="#090d16" stroke="#334155" stroke-width="2" />

                            <!-- Heavy Water Moderator Liquid Fill -->
                            <rect id="svgModeratorFill" x="182" y="90" width="236" height="218" rx="20" fill="#00f5d4" fill-opacity="0.65" style="transition: fill 0.6s ease, fill-opacity 0.6s ease;" />

                            <!-- Fuel Channel Pins (8 Channels) -->
                            <g id="svgFuelMatrix">
                                <rect class="fuel-pin" x="205" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="235" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="265" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="295" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="325" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="355" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                                <rect class="fuel-pin" x="385" y="110" width="16" height="170" rx="4" fill="#f59e0b" filter="url(#glow)" />
                            </g>

                            <!-- Pneumatic Control Rod Assembly (Slides Vertically) -->
                            <!-- y=20 (fully extracted) to y=90 (fully inserted) -->
                            <g id="svgControlRods" style="transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1); transform: translateY(45px);">
                                <rect x="200" y="0" width="206" height="10" rx="2" fill="#94a3b8" stroke="#cbd5e1" stroke-width="1.5"/>
                                <!-- Rod Shafts Penetrating into Core -->
                                <rect x="219" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                                <rect x="249" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                                <rect x="279" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                                <rect x="309" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                                <rect x="339" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                                <rect x="369" y="10" width="8" height="140" fill="#e2e8f0" stroke="#475569" stroke-width="1"/>
                            </g>

                            <!-- Calibration Overlay Legends -->
                            <text x="300" y="360" text-anchor="middle" fill="#94a3b8" font-size="12" font-family="monospace" font-weight="bold">
                                SIL-3 MULTI-CHANNEL REACTOR SIMULATION
                            </text>
                        </svg>
                    </div>
                </div>

                <!-- Live Graphical Instrument Dials & Metric Meters -->
                <div class="col-lg-5">
                    <div class="p-3 bg-white rounded border h-100 d-flex flex-column justify-content-between">
                        <div class="small fw-bold text-uppercase text-muted border-bottom pb-2 mb-3">
                            <i class="bi bi-speedometer2 text-primary me-1"></i> Core Instrumentation Telemetry
                        </div>

                        <!-- Metric 1: Core Thermal Output -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold text-dark">Thermal Power (MWth)</span>
                                <span class="badge bg-primary font-monospace fs-6" id="valThermalPower">16.00 MWth</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div id="barThermalPower" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 80%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted font-monospace mt-1" style="font-size: 0.72rem;">
                                <span>0 MWth</span>
                                <span>Rated: 20 MWth</span>
                            </div>
                        </div>

                        <!-- Metric 2: PHT Primary Coolant Pressure -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold text-dark">PHT Loop Pressure (bar)</span>
                                <span class="badge bg-info text-dark font-monospace fs-6" id="valCoolantPressure">139.4 bar</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div id="barCoolantPressure" class="progress-bar bg-info" role="progressbar" style="width: 87%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted font-monospace mt-1" style="font-size: 0.72rem;">
                                <span>100 bar</span>
                                <span>Limit: 160 bar</span>
                            </div>
                        </div>

                        <!-- Metric 3: Reactivity Suppressed -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small fw-bold text-dark">Reactivity Insertion (&Delta;&rho;)</span>
                                <span class="badge bg-warning text-dark font-monospace fs-6" id="valReactivityDelta">-140 pcm</span>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div id="barReactivity" class="progress-bar bg-warning" role="progressbar" style="width: 65%;"></div>
                            </div>
                            <div class="d-flex justify-content-between text-muted font-monospace mt-1" style="font-size: 0.72rem;">
                                <span>-300 pcm</span>
                                <span>0 pcm</span>
                            </div>
                        </div>

                        <!-- Metric 4: Moderator Purity & Core Inlet -->
                        <div class="p-2 bg-light rounded border small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Moderator Purity:</span>
                                <span class="fw-bold font-monospace text-dark" id="valModeratorPurity">99.82% D2O</span>
                            </div>
                            <div class="d-flex justify-content-between">
                                <span class="text-muted">Primary Delta-T:</span>
                                <span class="fw-bold font-monospace text-dark" id="valDeltaT">53.7 °C</span>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <div class="card-footer bg-light small text-muted d-flex justify-content-between align-items-center py-2">
            <span><i class="bi bi-shield-check text-success me-1"></i> AERB Digital Twin Simulator Active &bull; SIL-3 Interlock Bridge</span>
            <span class="font-monospace text-secondary" id="simLastAction">Initialized: Ready for component adjustment</span>
        </div>
    </div>

</div>

<script>
async function runSimulation(component) {
    const badgeEl = document.getElementById("simStatusBadge");
    const noticeEl = document.getElementById("syncNotice");
    const lastActionEl = document.getElementById("simLastAction");

    let val = "";
    if (component === "control_rods") {
        val = document.getElementById("rodSelect").value;
    } else if (component === "heavy_water") {
        val = document.getElementById("heavyWaterSelect").value;
    } else if (component === "fuel_assembly") {
        val = document.getElementById("fuelSelect").value;
    }

    badgeEl.className = "badge bg-warning text-dark font-monospace";
    badgeEl.innerText = "CALIBRATING...";

    try {
        const res = await fetch("/api/v1/simulation/adjust", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                component: component,
                setting: "auto",
                value: val
            })
        });

        const data = await res.json();
        badgeEl.className = "badge bg-success font-monospace";
        badgeEl.innerText = "SYNCHRONIZED";
        lastActionEl.innerText = `Calibrated: ${data.action} (${data.applied_value})`;

        // =====================================================================
        // GRAPHICAL VISUAL UPDATES (NO RAW TEXT OR SECRETS DISPLAYED ON SCREEN)
        // =====================================================================
        if (component === "control_rods") {
            const pct = parseInt(val, 10) || 50;
            // Translate the SVG control rods physically into the core
            // 0% -> translateY(0px), 100% -> translateY(90px)
            const translateY = Math.round((pct / 100) * 90);
            document.getElementById("svgControlRods").style.transform = `translateY(${translateY}px)`;

            // Update gauges
            if (data.simulation_metrics) {
                const pwr = data.simulation_metrics.core_thermal_power_mwth;
                document.getElementById("valThermalPower").innerText = `${pwr} MWth`;
                document.getElementById("barThermalPower").style.width = `${Math.min(100, (pwr / 20) * 100)}%`;

                const dRho = data.simulation_metrics.reactivity_delta_pcm;
                document.getElementById("valReactivityDelta").innerText = `${dRho} pcm`;
            }
        } else if (component === "heavy_water") {
            const flowRate = parseInt(val, 10) || 420;
            const fillEl = document.getElementById("svgModeratorFill");
            const pipeEl = document.getElementById("svgInletPipe");

            // Visually distinct color profiles for Heavy Water states:
            // 380 kg/s -> Cool Cobalt Ocean Blue (low recirculation)
            // 420 kg/s -> Bright Electric Turquoise / Cyan (nominal rated flow)
            // 460 kg/s -> Intense Cherenkov Neon Purple / Violet (high-velocity emergency recirculation)
            let waterColor = "#00f5d4"; // Default 420 nominal cyan
            let waterOpacity = "0.65";

            if (flowRate === 380) {
                waterColor = "#0284c7"; // Deep cobalt blue
                waterOpacity = "0.35";
            } else if (flowRate === 420) {
                waterColor = "#00f5d4"; // Electric turquoise
                waterOpacity = "0.65";
            } else if (flowRate === 460) {
                waterColor = "#a855f7"; // Glowing neon violet
                waterOpacity = "0.85";
            }

            fillEl.setAttribute("fill", waterColor);
            fillEl.setAttribute("fill-opacity", waterOpacity);
            if (pipeEl) {
                pipeEl.setAttribute("stroke", waterColor);
            }

            if (data.simulation_metrics) {
                const press = data.simulation_metrics.pht_coolant_pressure_bar;
                document.getElementById("valCoolantPressure").innerText = `${press} bar`;
                document.getElementById("barCoolantPressure").style.width = `${Math.min(100, (press / 160) * 100)}%`;

                document.getElementById("valModeratorPurity").innerText = data.simulation_metrics.isotopic_purity || "99.82% D2O";
            }
        } else if (component === "fuel_assembly") {
            // Update fuel pins color scheme based on selected fuel lattice
            const pins = document.querySelectorAll(".fuel-pin");
            let fuelColor = "#f59e0b"; // LEU Amber
            if (val === "MOX_4.0") {
                fuelColor = "#ef4444"; // MOX Crimson
            } else if (val === "THORIUM_NAT") {
                fuelColor = "#10b981"; // Thorium Emerald
            }
            pins.forEach(p => {
                p.setAttribute("fill", fuelColor);
            });
        }

    } catch (err) {
        console.error("Simulation request failed", err);
        badgeEl.className = "badge bg-danger font-monospace";
        badgeEl.innerText = "FAULT";
    }
}
</script>

<%- include('partials/footer') %>
