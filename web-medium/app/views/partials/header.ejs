<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MAIT-NRF | Nuclear Research Facility & Radiation Transparency Portal</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Institutional Top Notice Bar -->
    <div class="nrf-topbar py-1">
        <div class="container d-flex justify-content-between align-items-center">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check text-warning"></i>
                <span>AERB Statutory Public Radiological Transparency Network (PIRTN)</span>
            </span>
            <span class="d-none d-md-flex align-items-center gap-2">
                <% if (typeof req !== 'undefined' && req.cookies && req.cookies.Web_Chall_cookie) { %>
                    <span class="badge bg-info-subtle text-info border border-info font-monospace py-1 px-2">
                        <i class="bi bi-person-check-fill me-1"></i>CTF: <%= req.cookies.Web_Chall_cookie %>
                    </span>
                    <a href="/gate" class="text-secondary small text-decoration-none" title="Change CTF Email"><i class="bi bi-pencil-square"></i></a>
                <% } else { %>
                    <a href="/gate" class="badge bg-danger text-white text-decoration-none py-1">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>Web_Chall_cookie Missing
                    </a>
                <% } %>
                <span class="text-secondary">|</span>
                <span class="text-light opacity-75 font-monospace">incident-portal.internal</span>
            </span>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="navbar navbar-expand-xl nrf-navbar py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                <span class="nrf-brand-badge">MAIT-NRF</span>
                <span class="nrf-brand-title">Nuclear Research Facility</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navMenu">
                <!-- Main Nav Links -->
                <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1 ps-xl-3">
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/">
                            <i class="bi bi-house-door me-1 text-primary"></i>Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/telemetry">
                            <i class="bi bi-speedometer2 me-1 text-primary"></i>Telemetry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/reports">
                            <i class="bi bi-file-earmark-medical me-1 text-primary"></i>Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/research">
                            <i class="bi bi-journal-text me-1 text-primary"></i>Research
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/facility">
                            <i class="bi bi-cpu me-1 text-primary"></i>Facility
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/events">
                            <i class="bi bi-calendar-event me-1 text-primary"></i>Events
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-secondary fw-semibold py-1 px-2" href="/notifications">
                            <i class="bi bi-bell me-1 text-primary"></i>Gazette
                        </a>
                    </li>
                </ul>

                <!-- Universal Search Bar -->
                <form action="/search" method="GET" class="d-flex align-items-center nav-search-form me-xl-3 mb-2 mb-xl-0">
                    <div class="input-group input-group-sm">
                        <input type="text" name="q" class="form-control nav-search-input bg-light border-subtle" placeholder="Search portal..." aria-label="Search" required>
                        <button class="btn btn-outline-secondary nav-search-btn bg-white text-primary" type="submit">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Auth / User Actions -->
                <ul class="navbar-nav align-items-center gap-2 mb-2 mb-xl-0">
                    <% if (user) { %>
                        <li class="nav-item">
                            <a class="nav-link text-secondary fw-semibold py-1" href="/dashboard">
                                <i class="bi bi-grid-1x2 me-1 text-primary"></i>Dashboard
                            </a>
                        </li>
                        <% if (isPrivileged) { %>
                        <li class="nav-item">
                            <a class="nav-link text-danger fw-bold py-1" href="/reactor/scram/override">
                                <i class="bi bi-shield-slash-fill me-1"></i>SCRAM
                            </a>
                        </li>
                        <% } %>
                        <li class="nav-item">
                            <span class="badge <%= isPrivileged ? 'bg-danger text-white' : 'bg-light text-dark border' %> text-uppercase py-2 px-2 fw-bold font-monospace small">
                                <i class="bi bi-person-badge me-1"></i> <%= user.sub %> (<%= user.role %>)
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-outline-secondary" href="/logout" title="Sign Out">
                                <i class="bi bi-box-arrow-right"></i>
                            </a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="btn btn-sm btn-institutional-primary px-3 shadow-sm" href="/login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Portal Sign In
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </header>

    <main class="flex-grow-1">
