<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rakshna CTF Gateway</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f1f5f9;
            color: #1e293b;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .gateway-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            max-width: 480px;
            width: 100%;
            padding: 2.5rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 8px 10px -6px rgba(0, 0, 0, 0.01);
        }
        .btn-primary-custom {
            background-color: #2563eb;
            color: #ffffff;
            font-weight: 600;
            border: none;
            padding: 0.75rem;
            border-radius: 8px;
            transition: background-color 0.15s ease-in-out;
        }
        .btn-primary-custom:hover {
            background-color: #1d4ed8;
            color: #ffffff;
        }
        .form-control-custom {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
        }
        .form-control-custom:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        }
    </style>
</head>
<body>
    <div class="gateway-card">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-slate-900 mb-1">Rakshna CTF Gateway</h3>
            <p class="text-muted small mb-0">Session Identity Verification</p>
        </div>

        <% if (error) { %>
        <div class="alert alert-danger py-2 px-3 small mb-4" role="alert">
            <%= error %>
        </div>
        <% } %>

        <div class="alert alert-light border border-slate-200 py-3 px-3 small text-secondary mb-4">
            Please enter the exact email address registered on your CTF platform profile. This is to ensure you get your flag that is accepted by the CTF platform else your flag wouldnot get submitted
        </div>

        <form action="/gate/submit" method="POST">
            <input type="hidden" name="next" value="<%= nextUrl %>">
            
            <div class="mb-4">
                <label for="email" class="form-label text-dark fw-semibold small">
                    Registered CTF Email Address
                </label>
                <input 
                    type="email" 
                    class="form-control form-control-custom" 
                    id="email" 
                    name="email" 
                    placeholder="user@example.com" 
                    value="<%= currentEmail %>" 
                    required 
                    autocomplete="email"
                    autofocus
                >
            </div>

            <button type="submit" class="btn btn-primary-custom w-100">
                Continue to Challenge
            </button>
        </form>
    </div>
</body>
</html>
